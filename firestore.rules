rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile Documents
    match /users/{userId} {
      // Allow reading and listing of user accounts so profiles and admin panel can sync across devices
      allow get, list: if true;
      
      // Allow creating and updating user profile documents
      allow create, update: if isValidId(userId);
      
      // Delete reserved for owner/admin
      allow delete: if request.auth != null && (
        (request.auth.token.email is string && request.auth.token.email == 'jaydentorru4@gmail.com') ||
        request.auth.uid == 'jaydentorru4@gmail.com'
      );

      // User Favorites Subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isValidId(userId);
      }
    }

    // Default-deny all other unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
